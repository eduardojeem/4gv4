NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Solo servidor. Nunca uses el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Identidad y datos de respaldo de la plataforma
NEXT_PUBLIC_COMPANY_NAME=MiTiendaPy
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_RUC=
NEXT_PUBLIC_LOCALE=es-PY
NEXT_PUBLIC_CURRENCY=PYG
NEXT_PUBLIC_TAX_RATE=0.10
NEXT_PUBLIC_PRICES_INCLUDE_TAX=true

# Public Session Secret (for JWT tokens in public portal)
PUBLIC_SESSION_SECRET=your-secret-key-change-in-production-min-32-chars

# Cloudflare Turnstile + Supabase Auth
# Public site key used by the browser widget. Configure it in Vercel and .env.local.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
# Keep this secret server-side. With native Supabase CAPTCHA protection, store it
# in Supabase > Authentication > Bot and Abuse Protection; the app does not read it.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key


# Public support WhatsApp (international format without '+')
NEXT_PUBLIC_SUPPORT_WHATSAPP=595981234567

# WhatsApp Business Number (for customer communications)
NEXT_PUBLIC_WHATSAPP_BUSINESS=595981234567

# WhatsApp Cloud API (server-side delivery for repairs communications)
# Token permanente o de sistema de Meta
WHATSAPP_CLOUD_API_TOKEN=your_whatsapp_cloud_api_token
# Phone Number ID de WhatsApp Cloud (no es el numero telefonico)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Optional: Graph API version
WHATSAPP_CLOUD_API_VERSION=v21.0

# Repair QR Code Secret (for hash generation and verification)
# IMPORTANT: Change this to a random 32+ character string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPAIR_QR_SECRET=change-this-to-a-secure-random-string-in-production

# URLs canónicas de la aplicación
# En producción, las tres deben usar el dominio público con HTTPS.
# In development, it will automatically use window.location.origin
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
NEXT_PUBLIC_APP_URL=https://tu-dominio.com
NEXT_PUBLIC_BASE_URL=https://tu-dominio.com
APP_URL=https://tu-dominio.com

# Root domain for multi-tenant subdomain resolution
# Set this to your production domain so the middleware doesn't mistake
# the root domain for a tenant slug (e.g. 4gcelulares.com -> not a tenant)
# If tenants use subdomains like tenant.tudominio.com, set this:
APP_ROOT_DOMAIN=tu-dominio.com
NEXT_PUBLIC_BASE_DOMAIN=tu-dominio.com

# Organización usada únicamente como fallback en rutas públicas heredadas
DEFAULT_PUBLIC_ORG_SLUG=mi-organizacion

# Pagopar subscriptions checkout
# Public/private keys from Pagopar > Integrar con mi sitio web
PAGOPAR_PUBLIC_KEY=your_pagopar_public_key
PAGOPAR_PRIVATE_KEY=your_pagopar_private_key
# Used when subscription_plans prices are in USD and Pagopar charges in PYG
PAGOPAR_USD_TO_PYG=7300
# Optional payment method id: 9 card, 24 QR, 10 Tigo Money, etc.
PAGOPAR_DEFAULT_PAYMENT_METHOD=9

# Vercel V0 API (for AI-powered component generation)
V0_API_KEY=your_v0_api_key
V0_PROJECT_ID=your_v0_project_id

# Upstash Redis — global rate limiting (shared across serverless instances)
# Create a free database at https://console.upstash.com and paste the REST credentials here.
# When absent, the app falls back to a per-instance in-memory limiter (dev only).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# --- Email (Resend) ---
# API key de https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado. Ej: "Mi Tienda <noreply@midominio.com>".
# Si se deja vacío se usa onboarding@resend.dev (solo para pruebas).
EMAIL_FROM=
EMAIL_REPLY_TO=

# Protege los endpoints /api/cron. Debe coincidir con el secreto del scheduler.
CRON_SECRET=change-this-to-a-secure-random-string-in-production

# ── Service worker (PWA) ──────────────────────────────────────────────────────
# Interruptor de apagado de emergencia. Un service worker instalado sigue
# interceptando peticiones en el navegador del usuario aunque despliegues una
# corrección, así que este es el modo de desactivarlo a distancia.
# Poner en 1 y desplegar: los navegadores lo desregistran y borran su caché.
# Vacío o 0 = service worker activo (comportamiento normal).
NEXT_PUBLIC_DISABLE_SERVICE_WORKER=
